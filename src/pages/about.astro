---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Zuzu — Background & Experience',
  description: "Learn about Zuzu's background, experience, certifications, and expertise in AI/ML and Robotics.",
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About Me"
    actions={[
      {
        variant: 'primary',
        text: 'View LinkedIn Profile',
        href: 'https://www.linkedin.com/in/zulaikhahabib',
        target: '_blank',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  >
    <Fragment slot="title">
      Hi, I'm <span class="text-accent dark:text-white">Zuzu</span><br />
      <span class="text-3xl sm:text-4xl">Software Engineer</span>
    </Fragment>

    <Fragment slot="subtitle">
      Computing and Software Systems graduate from the University of Melbourne. I specialize in AI development, working
      with LLMs, building agentic systems, and creating robotics applications. Through Dabozai, I deliver practical AI
      training where students build real projects. I'm driven by turning complex technology into something people can
      actually use.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <!-- Stats
    title="Career Highlights"
    stats={[
      { title: 'Research Papers', amount: '8' },
      { title: 'Projects Completed', amount: '25+' },
      { title: 'GitHub Stars', amount: '2.5K' },
      { title: 'Training Hours', amount: '500+' },
    ]}
  / -->

  <!-- Experience Section ************** -->

  <!-- Steps2
    title="Professional Experience"
    subtitle="Building AI systems from research to production"
    items={}
  / -->

  <!-- Education Section ************** -->

  <Features2
    title="Academic Background"
    subtitle="Strong Academic Foundation — Combining rigorous academic training with hands-on practical experience."
    tagline="Education"
    columns={1}
    items={[
      {
        title: 'University of Melbourne',
        description:
          'Bachelor of Science (Computing and Software Systems), 2022-2025. Melbourne International Undergraduate Scholarship recipient.',
        icon: 'tabler:school',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Certifications ************** -->

  <Features3
    title="Certifications"
    subtitle="Industry-recognized credentials validating expertise"
    columns={3}
    items={[
      {
        title: 'AWS Certified Generative AI Developer - Professional',
        description:
          'Advanced skills in building and deploying production-ready AI solutions using AWS services like Amazon Bedrock.',
        icon: 'tabler:cloud',
      },
      {
        title: 'AWS Certified AI Practitioner',
        description:
          'Knowledge of artificial intelligence (AI), machine learning (ML), and generative AI concepts and use cases.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Certified Associated Python Programming (PCAP)',
        description:
          'Professional certification demonstrating proficiency in Python programming fundamentals and best practices.',
        icon: 'tabler:brand-python',
      },
    ]}
  />

  <!-- Projects Section ************** -->

  <Features2
    title="Projects"
    subtitle="Key projects showcasing practical application of AI and software development skills."
    tagline="Portfolio"
    columns={2}
    items={[
      {
        title: 'Mental Health Services Navigation - Capstone Project',
        description:
          'Built LLM-backed mental health services navigation chatbot with RAG implementation, vector search, and geofencing for Victoria. Tech stack: Python, LangChain, Supabase (Postgres + pgvector), React, FastAPI, Google Cloud Run.',
        icon: 'tabler:flask',
      },
      {
        title: 'Automating Operational Tasks',
        description:
          'Working as part of the IT operations team, automated day-to-day operational tasks including data loading and cleaning for CMDB service team, identifying unused AWS resources, generating billing reports per department, full inventory across accounts/regions, identifying stale IAM users, checking publicly accessible S3 buckets, and generating IAM access reports.',
        icon: 'tabler:automation',
      },
      {
        title: 'Sokoban Puzzle AI Solver',
        description:
          'Built an AI-powered solver for the Sokoban box-pushing puzzle game. Implemented Dijkstra\'s graph search algorithm with custom priority queue and hash table for efficient state-space exploration. Developed deadlock detection optimizations to prune unsolvable states early. Tech stack: Python with custom data structures.',
        icon: 'tabler:puzzle',
      },
      {
        title: 'Netflix Content Rating and Genre Prediction Using NLP',
        description:
          'Worked in a team to investigate the relationship between Netflix content descriptions and their associated ratings across genres. Built genre prediction model using Logistic Regression on TF-IDF vectorized descriptions. Developed Random Forest regression model to predict IMDB/TMDB scores. Performed data preprocessing including lemmatization, stop word removal across ~5,850 titles. Tech stack: Python, scikit-learn, NLTK, spaCy, matplotlib, pandas.',
        icon: 'tabler:movie',
      },
    ]}
  />

  <!-- Skills Section ************** -->

  <Features2
    title="Technical Skills"
    subtitle="Technologies and frameworks I work with"
    tagline="Expertise"
    columns={3}
    items={[
      {
        title: 'LLM & AI Agents',
        description:
          'LangChain, Strands Agents, AWS AgentCore, AnythingLLM, LangFlow, Composio, Claude Code, Prompt Engineering, RAG Systems, Transformers Architecture',
        icon: 'tabler:message-chatbot',
      },
      {
        title: 'Programming & Frameworks',
        description: 'Python, React, TypeScript/JavaScript, FastAPI, Supabase (Postgres + pgvector)',
        icon: 'tabler:code',
      },
      {
        title: 'Cloud & DevOps',
        description: 'AWS (Lambda, API Gateway, SageMaker), Google Cloud Platform (Cloud Run), Docker, Vercel',
        icon: 'tabler:cloud-computing',
      },
      {
        title: 'Specialized Areas',
        description: 'Computer Vision, Robotics, Sensors (temperature, humidity, motion), Object Recognition',
        icon: 'tabler:robot',
      },
      {
        title: 'Development Practices',
        description: 'Agile/Scrum methodology, Sprint planning, Stakeholder management, POC evaluation',
        icon: 'tabler:users',
      },
      {
        title: 'Data & Databases',
        description: 'PostgreSQL, Supabase, pgvector, Vector databases, Data preprocessing, ETL pipelines, Pandas, Data cleaning and transformation',
        icon: 'tabler:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Values Section ************** -->

  <Steps2
    title="My Values"
    subtitle="Principles that guide my work"
    isReversed={false}
    items={[
      {
        title: 'Quality & Innovation',
        description:
          'Building reliable software with emerging technologies, always seeking companies that value quality and continuous improvement.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Ownership & Quick Learning',
        description:
          'Taking full ownership of tasks and rapidly learning new tools and technologies to deliver results.',
        icon: 'tabler:target',
      },
      {
        title: 'Knowledge Sharing & Training',
        description:
          'Through Dabozai, providing structured Gen AI and robotics training with hands-on labs, helping others build practical skills.',
        icon: 'tabler:share',
      },
      {
        title: 'Collaborative Teamwork',
        description:
          'Working effectively in teams, staying calm under pressure, and supporting colleagues to achieve shared goals.',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- Contact Section ************** -->

  <Features2
    title="Get in Touch"
    tagline="Contact"
    columns={2}
    items={[
      {
        title: 'Location',
        description: 'Melbourne, Australia',
        icon: 'tabler:map-pin',
      },
      {
        title: 'LinkedIn',
        description: 'linkedin.com/in/zulaikhahabib',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <!-- <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'View Portfolio',
        href: '/portfolio',
        icon: 'tabler:briefcase',
      },
      {
        text: 'Contact Me',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title"> Ready to Work Together? </Fragment>

    <Fragment slot="subtitle">
      Whether you need AI consulting, custom development, or training, I'm here to help bring your ideas to life.
    </Fragment>
  </CallToAction> -->
</Layout>
