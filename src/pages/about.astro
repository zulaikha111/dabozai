---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Zuzu — Background & Experience',
  description: "Learn about Zuzu's background, experience, certifications, and expertise in AI/ML and Robotics.",
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About Me"
    actions={[
      {
        variant: 'primary',
        text: 'View LinkedIn Profile',
        href: 'https://www.linkedin.com/in/zulaikhahabib',
        target: '_blank',
        icon: 'tabler:brand-linkedin',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1620712943543-bcc4688e7485?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'AI and Machine Learning',
    }}
  >
    <Fragment slot="title">
      Hi, I'm <span class="text-accent dark:text-white">Zuzu</span><br />
      <span class="text-3xl sm:text-4xl">AI/ML Engineer & Robotics Specialist</span>
    </Fragment>

    <Fragment slot="subtitle">
      I graduated from the University of Melbourne with a degree in Computing and Software Systems. I love building with
      AI—from working with language models to teaching robots to see. What drives me is taking complex AI concepts and
      turning them into practical tools that actually solve real problems. Through Dabozai, I combine my passion for
      teaching and technology by helping others build their own AI projects from the ground up.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <!-- Stats
    title="Career Highlights"
    stats={[
      { title: 'Research Papers', amount: '8' },
      { title: 'Projects Completed', amount: '25+' },
      { title: 'GitHub Stars', amount: '2.5K' },
      { title: 'Training Hours', amount: '500+' },
    ]}
  / -->

  <!-- Experience Section ************** -->

  <!-- Steps2
    title="Professional Experience"
    subtitle="Building AI systems from research to production"
    items={}
  / -->

  <!-- Education Section ************** -->

  <Features2
    title="Academic Background"
    subtitle="Strong Academic Foundation — Combining rigorous academic training with hands-on practical experience."
    tagline="Education"
    columns={2}
    items={[
      {
        title: 'University of Melbourne',
        description:
          'Bachelor of Science (Computing and Software Systems), 2022-2025. Melbourne International Undergraduate Scholarship recipient.',
        icon: 'tabler:school',
      },
      {
        title: 'Capstone Project',
        description:
          'Built LLM-backed mental health services navigation chatbot with RAG implementation, vector search, and geofencing for Victoria.',
        icon: 'tabler:flask',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Certifications ************** -->

  <Features3
    title="Certifications"
    subtitle="Industry-recognized credentials validating expertise"
    columns={3}
    items={[
      {
        title: 'AWS Certified Generative AI Developer - Professional',
        description:
          'Advanced skills in building and deploying production-ready AI solutions using AWS services like Amazon Bedrock.',
        icon: 'tabler:cloud',
      },
      {
        title: 'AWS Certified AI Practitioner',
        description:
          'Knowledge of artificial intelligence (AI), machine learning (ML), and generative AI concepts and use cases.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Certified Associated Python Programming (PCAP)',
        description:
          'Professional certification demonstrating proficiency in Python programming fundamentals and best practices.',
        icon: 'tabler:brand-python',
      },
    ]}
  />

  <!-- Skills Section ************** -->

  <Features2
    title="Technical Skills"
    subtitle="Technologies and frameworks I work with"
    tagline="Expertise"
    columns={3}
    items={[
      {
        title: 'LLM & AI Agents',
        description:
          'LangChain, Strands Agents, AWS AgentCore, AnythingLLM, LangFlow, Composio, Claude Code, Prompt Engineering, RAG Systems, Transformers Architecture',
        icon: 'tabler:message-chatbot',
      },
      {
        title: 'Programming & Frameworks',
        description: 'Python, React, TypeScript/JavaScript, FastAPI, Supabase (Postgres + pgvector)',
        icon: 'tabler:code',
      },
      {
        title: 'Cloud & DevOps',
        description: 'AWS (Lambda, API Gateway, SageMaker), Google Cloud Platform (Cloud Run), Docker, Vercel',
        icon: 'tabler:cloud-computing',
      },
      {
        title: 'Specialized Areas',
        description: 'Computer Vision, Robotics, Sensors (temperature, humidity, motion), Object Recognition',
        icon: 'tabler:robot',
      },
      {
        title: 'Development Practices',
        description: 'Agile/Scrum methodology, Sprint planning, Stakeholder management, POC evaluation',
        icon: 'tabler:users',
      },
      {
        title: 'Soft Skills',
        description: 'Leadership, Critical Thinking, Training & Mentoring, Time Management, Teamwork',
        icon: 'tabler:heart',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Values Section ************** -->

  <Steps2
    title="My Values"
    subtitle="Principles that guide my work"
    isReversed={true}
    items={[
      {
        title: 'Quality & Innovation',
        description:
          'Building reliable software with emerging technologies, always seeking companies that value quality and continuous improvement.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Ownership & Quick Learning',
        description:
          'Taking full ownership of tasks and rapidly learning new tools and technologies to deliver results.',
        icon: 'tabler:target',
      },
      {
        title: 'Knowledge Sharing & Training',
        description:
          'Through Dabozai, providing structured Gen AI and robotics training with hands-on labs, helping others build practical skills.',
        icon: 'tabler:share',
      },
      {
        title: 'Collaborative Teamwork',
        description:
          'Working effectively in teams, staying calm under pressure, and supporting colleagues to achieve shared goals.',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- Contact Section ************** -->

  <Features2
    title="Get in Touch"
    tagline="Contact"
    columns={3}
    items={[
      {
        title: 'Email',
        description: 'zuzu@example.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Location',
        description: 'Melbourne, Australia',
        icon: 'tabler:map-pin',
      },
      {
        title: 'LinkedIn',
        description: 'linkedin.com/in/zulaikhahabib',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'View Portfolio',
        href: '/portfolio',
        icon: 'tabler:briefcase',
      },
      {
        text: 'Contact Me',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title"> Ready to Work Together? </Fragment>

    <Fragment slot="subtitle">
      Whether you need AI consulting, custom development, or training, I'm here to help bring your ideas to life.
    </Fragment>
  </CallToAction>
</Layout>
