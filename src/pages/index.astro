---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Zuzu — Software Engineer',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'View CV',
        href: '/about',
        icon: 'tabler:briefcase',
      },
      { text: 'Contact Me', href: '/contact', icon: 'tabler:mail' },
    ]}
  >
    <Fragment slot="title">
      Hi, I'm <span class="text-accent dark:text-white">Zuzu</span><br />
      <span class="text-3xl sm:text-4xl">Software Engineer</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        Computing and Software Systems graduate from the <span class="font-semibold">University of Melbourne</span>. I
        specialize in AI development, working with LLMs, building agentic systems, and creating robotics applications.
        Through Dabozai, I deliver practical AI training where students build real projects. I'm driven by turning
        complex technology into something people can actually use.
      </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">University of Melbourne Graduate</span>
      I specialize in AI development, working with LLMs, building agentic systems, and creating robotics applications.
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->

  <Features
    id="expertise"
    tagline="Expertise"
    title="Areas of Specialization"
    subtitle="Combining deep technical knowledge with practical experience to deliver innovative AI solutions."
    items={[
      {
        title: 'Large Language Models (LLMs)',
        description:
          'Expert in fine-tuning, prompt engineering, and deploying LLMs for various applications including chatbots, code generation, and knowledge retrieval systems.',
        icon: 'tabler:message-chatbot',
      },
      {
        title: 'Agentic AI Systems',
        description:
          'Building autonomous AI agents that can reason, plan, and execute complex tasks using frameworks like LangChain, AutoGPT, and custom agent architectures.',
        icon: 'tabler:robot',
      },
      {
        title: 'Cloud Engineering & DevOps',
        description:
          'Hands-on experience deploying applications via core AWS services and automating delivery workflows using CI/CD pipeline integration',
        icon: 'tabler:brain',
      },
      {
        title: 'Robotics & Autonomous Systems',
        description:
          'Experience with I2C, motion planning, and sensor fusion for building intelligent robotic systems.',
        icon: 'tabler:drone',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Background"
    title="Education & Research Foundation"
    items={[
      {
        title: 'University of Melbourne',
        description:
          'Bachelor of Science (Computing and Software Systems) — Melbourne International Undergraduate Scholarship recipient.',
      },
      {
        title: 'GenAI Professional Certification',
        description: 'AWS Certified Generative AI Developer - Professional, AWS Certified AI Practitioner',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1620712943543-bcc4688e7485?ixlib=rb-4.0.3&auto=format&fit=crop&w=1965&q=80',
      alt: 'AI and Machine Learning',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Building on Strong Foundations</h3>
      Combining academic excellence with hands-on experience in cutting-edge AI technologies.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'LLM-Powered Applications',
        description:
          'Developed production-ready applications using GPT-4, Claude, and open-source models like LLaMA and Mistral.',
      },
      {
        title: 'Multi-Agent Coordination',
        description:
          'Designed systems where multiple AI agents collaborate to solve complex tasks through communication and planning.',
      },
      {
        title: 'Computer Vision Systems',
        description: 'Implemented object detection, segmentation, and Facial Expression Detection (FED)',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1485827404703-89b55fcc595e?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Robotics',
    }}
  >
    <Fragment slot="content">Turning research into real-world impact.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="How I Can Help You"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Consultation</span>',
        description:
          "We discuss your AI/ML needs, whether it's building an LLM application, implementing computer vision, or developing robotic systems.",
        icon: 'tabler:message-circle',
      },
      {
        title: 'Step 2: <span class="font-medium">Solution Design</span>',
        description:
          'I design a tailored solution architecture, selecting the right models, frameworks, and infrastructure for your use case.',
        icon: 'tabler:clipboard-list',
      },
      {
        title: 'Step 3: <span class="font-medium">Development & Training</span>',
        description:
          'Building and training models, developing applications, and integrating AI capabilities into your existing systems.',
        icon: 'tabler:code',
      },
      {
        title: 'Deployed & Supported!',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Technical Skills"
    subtitle="Technologies and frameworks I work with daily"
    tagline="Tech Stack"
    items={[
      {
        title: 'Python',
        description: 'Development expertise in Python',
        icon: 'tabler:brand-python',
      },
      {
        title: 'LangChain & Amazon Bedrock',
        description: 'Building RAG systems, agents, and LLM-powered applications.',
        icon: 'tabler:link',
      },
      {
        title: 'Docker',
        description: 'Containerization and orchestration.',
        icon: 'tabler:brand-docker',
      },
      {
        title: 'AWS',
        description: 'AWS Cloud services expertise.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Hugging Face',
        description: 'Transformers library and model hub for NLP and multimodal AI.',
        icon: 'tabler:mood-smile',
      },
      {
        title: 'Git & DevOps',
        description: 'Good understanding of DevOps, CI/CD, and Git ',
        icon: 'tabler:git-branch',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Stats Widget ****************** -->

  <!-- Stats
    stats={[
      { title: 'Research Papers', amount: '8' },
      { title: 'Projects Completed', amount: '25+' },
      { title: 'GitHub Stars', amount: '2.5K' },
      { title: 'Training Hours', amount: '500+' },
    ]}
  / -->

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get in Touch',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to Build Something<br class="block sm:hidden" /><span class="sm:whitespace-nowrap"> Amazing with AI?</span>
    </Fragment>

    <Fragment slot="subtitle">
      Let's discuss how AI can transform your business or bring your ideas to life.<br class="hidden md:inline" />
      I'm always excited to work on challenging and innovative projects.
    </Fragment>
  </CallToAction>
</Layout>
